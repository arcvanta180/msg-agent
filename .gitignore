# 依赖与包管理器缓存（保留 pnpm-lock.yaml）
node_modules/
.pnpm-store/
.npm/

# 构建产物与工具缓存
dist/
build/
.vite/
.vite-temp/
.vitest/
.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# 本地环境变量（保留可公开的示例配置）
.env
.env.*
!.env.example
!.env.*.example

# 测试报告、覆盖率及浏览器登录状态
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# 日志、进程文件与临时文件
logs/
*.log
*.log.*
*.pid
*.pid.lock
*.tmp
*.temp
/tmp/
/temp/

# 本地 PostgreSQL 数据与备份
/pgdata/
/postgres-data/
/backups/

# 本次代码交付不包含文档和演示媒体
/docs/
/media/

# 编辑器与本地 AI 工具配置
.idea/
.vscode/
.history/
/.codex/
/.claude/
/.agents/
/.cursor/

# 本地云服务及 SSH 凭据目录
/.aws/
/.ssh/

# 操作系统文件及编辑器临时文件
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.orig
*.rej
