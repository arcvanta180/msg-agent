{
  "name": "msg-agent",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:server && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "dev": "pnpm build:server && node scripts/dev.cjs",
    "start": "node dist/apps/api/src/main.js",
    "db:migrate": "pnpm build:server && node dist/packages/db/src/cli.js migrate",
    "db:seed": "node dist/packages/db/src/cli.js seed",
    "test": "node scripts/test.cjs",
    "test:integration": "node scripts/test.cjs tests/integration",
    "test:e2e": "playwright test",
    "demo:video": "pnpm build && node scripts/demo/record.cjs",
    "format": "prettier --write apps packages scripts tests '*.{json,yaml,ts}'",
    "format:check": "prettier --check apps packages scripts tests '*.{json,yaml,ts}'"
  },
  "dependencies": {
    "@ant-design/icons": "6.0.2",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/typeorm": "11.0.0",
    "@tanstack/react-query": "5.90.2",
    "ajv": "8.20.0",
    "antd": "5.27.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.8",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.4.0",
      "esbuild": "0.28.1"
    }
  }
}
